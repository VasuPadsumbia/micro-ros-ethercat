// ============================================================================
// tang_nano_20k.cst — Physical constraint file for Gowin GW2AR-18
//
// Tang Nano 20K pin assignments for micro-ROS EtherCAT slave
//
// VERIFY all pin numbers against your board schematic before synthesis.
// Numbers below are based on the Tang Nano 20K GW2AR-18 QFN88 package.
// The 40-pin expansion header (J2) provides GPIO:
//   Pins 1-20 on left rail, 21-40 on right rail.
//
// DP83848 MII connections (see hardware/wiring.md for full schematic):
//   TX_CLK is an INPUT from PHY (25 MHz at 100Mbps)
//   RX_CLK is an INPUT from PHY
//   MDIO is bidirectional open-drain
// ============================================================================

// ── System clock (27 MHz XTAL) ────────────────────────────────────────────
IO_LOC "clk_27"    4;   // CLKIN on Tang Nano 20K
IO_PORT "clk_27"   PULL_MODE=NONE IO_TYPE=LVCMOS33;

// ── Reset button ──────────────────────────────────────────────────────────
IO_LOC "btn_rst_n" 88;
IO_PORT "btn_rst_n" PULL_MODE=UP IO_TYPE=LVCMOS33;

// ── PHY0 MII (DP83848 #1 — Port 0, connects to EtherCAT master) ─────────
// TX path (FPGA drives, referenced to PHY TX_CLK)
IO_LOC "p0_tx_clk"  25;
IO_PORT "p0_tx_clk"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p0_txd[0]"  26;
IO_LOC "p0_txd[1]"  27;
IO_LOC "p0_txd[2]"  28;
IO_LOC "p0_txd[3]"  29;
IO_PORT "p0_txd[0]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "p0_txd[1]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "p0_txd[2]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "p0_txd[3]"  IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p0_tx_en"   30;
IO_PORT "p0_tx_en"  IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p0_tx_er"   31;
IO_PORT "p0_tx_er"  IO_TYPE=LVCMOS33;

// RX path (PHY drives, referenced to PHY RX_CLK)
IO_LOC "p0_rx_clk"  32;
IO_PORT "p0_rx_clk"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p0_rxd[0]"  33;
IO_LOC "p0_rxd[1]"  34;
IO_LOC "p0_rxd[2]"  35;
IO_LOC "p0_rxd[3]"  36;
IO_PORT "p0_rxd[0]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_PORT "p0_rxd[1]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_PORT "p0_rxd[2]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_PORT "p0_rxd[3]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p0_rx_dv"   37;
IO_PORT "p0_rx_dv"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p0_rx_er"   38;
IO_PORT "p0_rx_er"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

// Management
IO_LOC "p0_mdc"     39;
IO_PORT "p0_mdc"    IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "p0_mdio"    40;
IO_PORT "p0_mdio"   IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "p0_rst_n"   41;
IO_PORT "p0_rst_n"  IO_TYPE=LVCMOS33 DRIVE=8;

// ── PHY1 MII (DP83848 #2 — Port 1, optional downstream) ─────────────────
IO_LOC "p1_tx_clk"  42;
IO_PORT "p1_tx_clk"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p1_txd[0]"  43;
IO_LOC "p1_txd[1]"  44;
IO_LOC "p1_txd[2]"  45;
IO_LOC "p1_txd[3]"  46;
IO_PORT "p1_txd[0]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "p1_txd[1]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "p1_txd[2]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "p1_txd[3]"  IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p1_tx_en"   47;
IO_PORT "p1_tx_en"  IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "p1_tx_er"   48;
IO_PORT "p1_tx_er"  IO_TYPE=LVCMOS33;

IO_LOC "p1_rx_clk"  49;
IO_PORT "p1_rx_clk"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p1_rxd[0]"  50;
IO_LOC "p1_rxd[1]"  51;
IO_LOC "p1_rxd[2]"  52;
IO_LOC "p1_rxd[3]"  53;
IO_PORT "p1_rxd[0]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_PORT "p1_rxd[1]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_PORT "p1_rxd[2]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;
IO_PORT "p1_rxd[3]"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p1_rx_dv"   54;
IO_PORT "p1_rx_dv"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p1_rx_er"   55;
IO_PORT "p1_rx_er"  PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "p1_mdc"     56;
IO_PORT "p1_mdc"    IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "p1_mdio"    57;
IO_PORT "p1_mdio"   IO_TYPE=LVCMOS33 DRIVE=4;

IO_LOC "p1_rst_n"   58;
IO_PORT "p1_rst_n"  IO_TYPE=LVCMOS33 DRIVE=8;

// ── SPI slave (to ESP32 DevKit V4) ───────────────────────────────────────
// ESP32: SCLK=GPIO14, MOSI=GPIO13, MISO=GPIO12, CS=GPIO15, INT=GPIO4
IO_LOC "spi_sck"    63;
IO_PORT "spi_sck"   PULL_MODE=DOWN IO_TYPE=LVCMOS33;

IO_LOC "spi_mosi"   64;
IO_PORT "spi_mosi"  PULL_MODE=DOWN IO_TYPE=LVCMOS33;

IO_LOC "spi_miso"   65;
IO_PORT "spi_miso"  IO_TYPE=LVCMOS33 DRIVE=8;

IO_LOC "spi_cs_n"   66;
IO_PORT "spi_cs_n"  PULL_MODE=UP IO_TYPE=LVCMOS33;

IO_LOC "spi_int_n"  67;
IO_PORT "spi_int_n" IO_TYPE=LVCMOS33 DRIVE=4;

// ── I2C to AT24C256 EEPROM ───────────────────────────────────────────────
// External 4.7 kΩ pull-ups required on SCL and SDA
IO_LOC "i2c_scl"    68;
IO_PORT "i2c_scl"   PULL_MODE=NONE IO_TYPE=LVCMOS33;

IO_LOC "i2c_sda"    69;
IO_PORT "i2c_sda"   PULL_MODE=NONE IO_TYPE=LVCMOS33;

// ── Status LEDs (active-low on Tang Nano 20K) ────────────────────────────
IO_LOC "led_n[0]"   15;
IO_LOC "led_n[1]"   16;
IO_LOC "led_n[2]"   17;
IO_LOC "led_n[3]"   18;
IO_LOC "led_n[4]"   19;
IO_LOC "led_n[5]"   20;
IO_PORT "led_n[0]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[1]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[2]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[3]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[4]"  IO_TYPE=LVCMOS33 DRIVE=8;
IO_PORT "led_n[5]"  IO_TYPE=LVCMOS33 DRIVE=8;
